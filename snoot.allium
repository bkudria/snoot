-- allium: 3
-- code-health-wrapper.allium

-- Scope: Runtime behaviour of a Ruby gem that runs reek, flog and flay over a
--        configured path set and emits a single agent-targeted report
--        describing one finding.
-- Includes: invocation, finding collection, finding selection, report emission,
--           run outcomes (FindingRendered, NothingToReport, AnalysisFailed).
-- Excludes:
--   - Build-time vendored-doc workflow (sync, packaging, version pinning)
--   - Gem packaging, dependency management, CLI argument parsing internals
--   - CI gating policy and exit-code semantics (open question)
--   - Diff-aware analysis, JSON output, MCP, pre-commit hooks (non-goals
--     enumerated in the design doc)
-- Centred on: the LLM agent reading the emitted report.
-- Reference: ./CODE_HEALTH_WRAPPER.md (design notes superseded by this spec
--            on the single-finding selection model).

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The three analysers the gem orchestrates. Their internal behaviour is out
-- of scope; their findings are surfaced via black-box analyse_* functions.

external entity Reek {
    -- Reek detects code smells in Ruby source. A run yields zero or more Smell
    -- value instances, each tagged with a SmellType.
}

external entity Flog {
    -- Flog assigns a complexity score to methods and classes. A run yields
    -- zero or more ComplexityHit instances.
}

external entity Flay {
    -- Flay detects structural duplication across the analysed source. A run
    -- yields zero or more DuplicationCluster instances.
}

-- The two parties on the consumer side of the gem. Both are external: the
-- gem does not own their identity. Operator initiates a Run; ReportConsumer
-- reads its emitted bytes. The spec faces these entity types directly from
-- surfaces; no actor declarations are needed because no narrowing condition
-- applies (any Operator may invoke; any ReportConsumer may read).

external entity Operator {
    -- Whoever invokes the CLI. May be a human at a terminal, a CI process,
    -- or an agent shelling out. The spec does not distinguish.
}

external entity ReportConsumer {
    -- The party reading the emitted report. The spec is centred on the
    -- LLM coding agent in this role, but a developer reading stdout is a
    -- valid ReportConsumer too.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Path {
    raw: String
}

value Location {
    path: Path
    line_start: Integer
    line_end: Integer
}

-- A reek smell type identifier (e.g. "FeatureEnvy", "TooManyMethods"). The
-- set of valid values is owned by reek.
value SmellType {
    name: String
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A Finding is the unit a Run can render. It is one of three variants,
-- corresponding to the three analysers the gem orchestrates. Findings exist
-- only within the scope of the Run that produced them; they have no
-- persistence beyond the run.

entity Finding {
    kind: Smell | ComplexityHit | DuplicationCluster
}

variant Smell : Finding {
    smell_type: SmellType
    location: Location
    message: String
}

variant ComplexityHit : Finding {
    location: Location
    method_name: String?
    score: Decimal
}

variant DuplicationCluster : Finding {
    signature: String
    locations: Set<Location>
}

-- A Run represents one CLI invocation. Its lifecycle terminates in exactly
-- one of three outcomes.

entity Run {
    paths: Set<Path>
    outcome: pending | finding_rendered | nothing_to_report | analysis_failed

    selected_finding: Finding when outcome = finding_rendered

    transitions outcome {
        pending -> finding_rendered
        pending -> nothing_to_report
        pending -> analysis_failed
        terminal: finding_rendered, nothing_to_report, analysis_failed
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- The pipeline is two rules. AnalyseRun spans collection through selection
-- (it produces the terminal outcome). RenderReport reacts to a selected
-- finding by emitting the report.

rule AnalyseRun {
    when: RunInvoked(paths)

    -- Black-box analyser invocations. Each returns the analyser's findings
    -- for the configured path set, or signals failure via the
    -- analysers_succeeded predicate consulted below.
    let smell_findings = reek_analyse(paths)
    let complexity_findings = flog_analyse(paths)
    let duplication_findings = flay_analyse(paths)

    -- A reek smell is excluded from the candidate pool when no vendored doc
    -- exists for its type. If the would-have-been-selected finding (i.e. the
    -- top-scoring finding before this filter) is one of these, a stderr
    -- warning is emitted (see SkippedDocLessSmellWarned trigger below).
    let documented_smell_findings =
        filter(smell_findings, s => vendored_doc(s.smell_type) != null)

    let candidate_findings =
        documented_smell_findings + complexity_findings + duplication_findings

    let top_finding_overall = select_top_finding(
        smell_findings + complexity_findings + duplication_findings
    )

    let selected = select_top_finding(candidate_findings)

    ensures:
        let run = Run.created(paths: paths, outcome: pending)
        if not analysers_succeeded(paths):
            run.outcome = analysis_failed
        else:
            if candidate_findings.count = 0:
                run.outcome = nothing_to_report
            else:
                run.outcome = finding_rendered
                run.selected_finding = selected

            -- Stderr warning fires when the top finding overall (before
            -- the doc-less filter) is a smell whose doc is missing. The
            -- nested if-guards narrow top_finding_overall to a Smell
            -- variant before accessing smell_type.
            if top_finding_overall != null:
                if top_finding_overall.kind = Smell:
                    if vendored_doc(top_finding_overall.smell_type) = null:
                        SkippedDocLessSmellWarned(
                            run: run,
                            smell_type: top_finding_overall.smell_type
                        )
}

rule RenderReport {
    when: run: Run.outcome becomes finding_rendered
    requires: run.selected_finding != null

    -- The report is composed of four sections, in this order. The doc
    -- section's content depends on the variant of the selected finding:
    --   - Smell:              vendored_doc(smell_type) (always non-null here,
    --                         per the SelectedFindingsAreRenderable invariant)
    --   - ComplexityHit:      hand-written generic prose for high complexity
    --   - DuplicationCluster: hand-written generic prose for high duplication
    --
    -- The framing prose anchors the agent's interpretation of the finding.
    -- Its exact wording is an open question (see below).
    ensures: ReportEmitted(
        run: run,
        finding: run.selected_finding,
        sections: { header, finding_context, doc, framing }
    )

    @guidance
        -- The four-section ordering is structural. Implementations should
        -- emit them in this order so an agent / parser can rely on
        -- predictable landmarks.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A rendered run references exactly one finding. There is no concept of a
-- top-tier of multiple findings in this spec.
invariant SingleFindingPerRun {
    for r in Runs:
        r.outcome = finding_rendered implies r.selected_finding != null
}

-- The selection filter excludes doc-less smells. Therefore: when a run's
-- selected_finding is a Smell, that smell type has a vendored doc
-- available. The quantification ranges over Smell instances directly so
-- variant-specific access (smell_type) is unambiguous; the equality with
-- selected_finding pins the relationship.
invariant SelectedFindingsAreRenderable {
    for r in Runs:
        for s in Smells:
            (r.outcome = finding_rendered and r.selected_finding = s)
                implies vendored_doc(s.smell_type) != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface CLI {
    facing operator: Operator

    -- The CLI's only domain input is the path set. Other flags (verbosity,
    -- output destination) are out of scope at the spec level.
    provides:
        RunInvoked(operator, paths)

    @guarantee TerminatesInOneOutcome
        -- Every accepted invocation produces exactly one of the three
        -- terminal outcomes (FindingRendered, NothingToReport,
        -- AnalysisFailed). The spec does not specify the exit code; that
        -- is an open question.

    @guarantee StdoutMutuallyExclusive
        -- A run produces stdout content corresponding to its outcome:
        --   finding_rendered  -> stdout = formatted four-section report
        --   nothing_to_report -> stdout = 'nothing to report' acknowledgement
        --   analysis_failed   -> stdout = empty
        -- Stderr carries warnings (missing vendored docs) and analyser
        -- failure detail; these are independent of stdout content.
}

surface ReportReader {
    facing reader: ReportConsumer

    context run: Run where outcome = finding_rendered

    -- The agent's view of a rendered report. Section identifiers are
    -- structural anchors; their content is the implementation's
    -- responsibility, but the four sections always appear in this order.
    exposes:
        run.selected_finding
        run.selected_finding.kind

    @guarantee FourSectionStructuralContract
        -- A rendered report contains, in order:
        --   1. Header        -- one-line summary (analyser-implicit, finding
        --                       name, location)
        --   2. FindingContext -- file path(s), line range(s), the analyser's
        --                       message; for DuplicationCluster, all cluster
        --                       locations are enumerated
        --   3. Doc           -- exactly one inlined doc:
        --                       - Smell              -> vendored markdown
        --                       - ComplexityHit      -> hand-written prose
        --                       - DuplicationCluster -> hand-written prose
        --   4. Framing       -- closing prose directing the agent's reading

    @guarantee AnalyserProvenanceImplicit
        -- The report does not label the originating analyser. The shape of
        -- the finding (smell name vs complexity language vs duplication
        -- enumeration) is sufficient for the agent to infer provenance.

    @guidance
        -- The agent should treat the single inlined doc as primary context
        -- for acting on the finding, and the framing prose as instructions
        -- on how to read the doc relative to the finding.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Cost-ranking formula -- how select_top_finding combines reek smell severity, flog complexity scores, and flay duplication signal into a single ordering across all three categories"

open question "Tie-breaking -- when multiple candidate findings tie at the highest score, which one wins (the spec asserts only that selection is deterministic for a given input; the tie-break rule itself is implementation-defined)"

open question "Default path set -- whether RunInvoked defaults to a sensible glob (e.g. lib/**/*.rb) when paths is empty, or whether empty paths is rejected at the CLI surface"

open question "Exit-code policy -- whether the CLI exits 0/1 by outcome (finding rendered vs nothing to report) or always exits 0 except on AnalysisFailed; whether a configurable score-gate behaviour returns later"

open question "Framing prose wording -- the exact closing language for the framing section. The design doc's URL-centric draft predates the inline-docs decision; the wording needs adjustment for fully-inlined context"

open question "NothingToReport stdout content -- the exact wording / format of the 'nothing to report' acknowledgement, and whether it carries any structured information (paths examined, analysers run) or is purely a one-liner"

open question "AnalysisFailed surfacing -- what stderr carries on AnalysisFailed (per-analyser detail, the first failure, an aggregated message) and what level of detail the developer needs to act"
